# Moina chat — copy to .env and fill in. NEVER commit .env (it's gitignored).
#
# Local:      node tools/moina-dev-proxy.js   reads this file
# Production: set the same names in your host's dashboard
#             (Vercel → Project → Settings → Environment Variables)

# groq | gemini | xai
#   groq   = Groq Cloud, keys look like gsk_...   (api.groq.com)
#   xai    = xAI Grok,   keys look like xai-...   (api.x.ai)
#   These two are different companies — easy to mix up.
MOINA_PROVIDER=groq

# Only the one matching MOINA_PROVIDER is needed.
GROQ_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Optional. Defaults: llama-3.3-70b-versatile / gemini-2.5-flash / grok-3-mini
# On Groq, llama-3.3-70b-versatile handles both English and Assamese well.
# Avoid llama-3.1-8b-instant (invents Assamese words) and qwen3.6 (leaks <think>).
MOINA_MODEL=

# Model-based safety classifier (Groq-hosted; needs GROQ_API_KEY either way).
#   off   = wordlist + persona + output screen only
#   input = also classify the child's message           (default)
#   both  = also classify Moina's reply before display  (2x classifier calls)
# It fails OPEN: if the classifier errors or rate-limits, the other layers still
# apply rather than the child being stonewalled. Free tier caps this model at
# 8k tokens/min — roughly 15-20 checks a minute — so watch for 429s in the logs
# under real traffic and set this to `off` if it becomes the bottleneck.
MOINA_SAFEGUARD=input
MOINA_SAFEGUARD_MODEL=
MOINA_SAFEGUARD_TIMEOUT=
