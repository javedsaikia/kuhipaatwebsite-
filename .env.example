# Moina chat — copy to .env and fill in. NEVER commit .env (it's gitignored).
#
# Local:      node tools/moina-dev-proxy.js   reads this file
# Production: set the same names in Vercel → Settings → Environment Variables

# --- Moina AI chat ---
# groq | gemini | xai
MOINA_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MOINA_MODEL=
MOINA_SAFEGUARD=input
MOINA_SAFEGUARD_MODEL=
MOINA_SAFEGUARD_TIMEOUT=

CHAT_RATE_MAX=40
WAITLIST_RATE_MAX=8

# --- Early access waitlist storage (use at least one in production) ---
# Zapier/Make webhook — POST JSON { name, email, lang, source, at }
WAITLIST_WEBHOOK_URL=

# Or email yourself via Resend (https://resend.com)
RESEND_API_KEY=
WAITLIST_NOTIFY_EMAIL=you@example.com
# Must be a verified domain in Resend once you leave the sandbox:
WAITLIST_FROM_EMAIL=Moina Mel <waitlist@yourdomain.com>

# --- Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile) ---
# Widget hostnames: localhost, 127.0.0.1, kuhipaatwebsite.vercel.app (+ custom domain)
# Local dev test keys (always pass): https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Local: include localhost. Production (Vercel): kuhipaatwebsite.vercel.app only — no localhost.
TURNSTILE_HOSTNAMES=kuhipaatwebsite.vercel.app,localhost,127.0.0.1
TURNSTILE_ACTION=early-access